# Copy this file to .env and set your own values
# Either GH_TOKEN or GITHUB_TOKEN works with the Forge publish wrapper.
GH_TOKEN=your_github_personal_access_token

# Apple notarization credentials
APPLE_ID=you@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
APPLE_TEAM_ID=ABCDE12345

# Optional: force a specific keychain signing identity label
APPLE_SIGN_IDENTITY=Developer ID Application: Your Name (ABCDE12345)

